# MySQL connection (update with your credentials)
DATABASE_URL="mysql://root:1414@localhost:3306/studio_desk"

# Optional: lets the Inbox read pasted enquiries into booking details ("Read with AI").
# Without it the Inbox still works using "Save without reading".
ANTHROPIC_API_KEY=
# Optional override. Defaults to claude-opus-5. A smaller model is cheaper per message.
ANTHROPIC_MODEL=
NEXT_public_supabase_url=Your_supabase_URL
NEXT_public_supabase_ANON_KEY=YOUR_SUPABASE_ANON_KEY